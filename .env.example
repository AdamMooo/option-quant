# Copy to .env and fill in. Both keys are free-tier.

# Earnings dates and company news. Without it, both are silently absent.
# https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Macro header (VIX, VIX3M, 10Y, Fed Funds). Optional — falls back to the
# no-key FRED CSV endpoint, which is slower but works.
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
